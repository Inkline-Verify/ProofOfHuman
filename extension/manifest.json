{
  "manifest_version": 3,
  "name": "Inkline",
  "version": "0.1.0",
  "description": "Proof of Human for Gmail: approve each email with Touch ID and attach an offline-verifiable receipt.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "Inkline stamp"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "config.js",
        "stamp-style.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
